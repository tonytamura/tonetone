{
  "name": "tone-boom",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vite-node scripts/sim.ts --",
    "sim:physics": "vite-node scripts/sim.ts -- physics",
    "sim:invariants": "vite-node scripts/sim.ts -- invariants",
    "sim:baseline": "vite-node scripts/sim.ts -- baseline check",
    "verify": "npm run build && npm test && npm run sim:physics && npm run sim:invariants && npm run sim:baseline",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "check:strip": "vite-node scripts/check-strip.ts",
    "make:icons": "vite-node scripts/make-icons.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/screen-orientation": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  }
}